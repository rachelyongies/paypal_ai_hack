# Valet environment. Copy to .env.local for local dev.
# Every key is optional: without PayPal keys Valet runs a labelled simulator,
# without an Anthropic key the guardian falls back to deterministic rules.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same app, after you add https://<host>/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=
# Optional: a payment token (vault_id) from your sandbox buyer, used by the
# one-click "demo wallet" so judges can try Valet without a PayPal login.
DEMO_VAULT_ID=

# Claude (console.anthropic.com). Model defaults to claude-opus-5-5.
ANTHROPIC_API_KEY=
VALET_MODEL=claude-opus-5-5

# Public base URL, used for PayPal return URLs and QR approval links.
# On Render it defaults to RENDER_EXTERNAL_URL, so you can leave it unset there.
APP_URL=http://localhost:3000

# AG Grid Enterprise license (ask the AG Grid team for a hackathon key).
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=

# Optional: PKCS8 PEM of an ES256 key for signing receipts. Generated and
# stored in .data/ when empty.
VALET_SIGNING_KEY=

# Where Valet keeps its JSON store.
DATA_DIR=.data
