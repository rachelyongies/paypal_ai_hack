{
  "name": "valet",
  "version": "1.0.0",
  "private": true,
  "description": "Valet: a valet key for AI agents to pay with PayPal. PayPal AI Hackathon 2026.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "record": "node scripts/record-demo.mjs",
    "ad": "python3 scripts/make-music.py demo/out/valet-ad-music.wav && node scripts/render-ad.mjs",
    "demo:video": "python3 scripts/make-demo-video.py"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@fontsource-variable/inter": "5.3.0",
    "@paypal/agent-toolkit": "1.11.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-enterprise": "36.2.0",
    "ag-grid-react": "36.2.0",
    "jose": "6.2.15",
    "lucide-react": "1.67.0",
    "next": "15.5.29",
    "qrcode": "1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
